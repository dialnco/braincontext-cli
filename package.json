{
  "name": "braincontext-cli",
  "version": "0.6.5",
  "description": "Local-first SQLite CLI for saving and retrieving shared context across AI coding agents (Claude, Codex, Cursor, ...).",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bctx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "cli",
    "sqlite",
    "ai",
    "agents",
    "context",
    "memory",
    "local-first"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup && vite build -c studio/vite.config.ts",
    "studio:dev": "vite -c studio/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:studio": "tsc -p studio/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run typecheck:studio && npm run lint && npm run test && npm run build && npx publint"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@libsql/client": "^0.17.4",
    "@libsql/kysely-libsql": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "hono": "^4.12.27",
    "kysely": "^0.29.2",
    "ulidx": "^2.4.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
